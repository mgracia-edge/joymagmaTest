{
  "name": "magma-nx-studio",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "compile": "npx webpack --config webpack.config.js",
    "compile-watch": "npx webpack --config webpack.config.js --watch --mode=development",
    "heroku-postbuild": "npm run compile"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "browsers": [
              "last 2 versions",
              "safari >= 7",
              "ie >= 11"
            ]
          }
        }
      ]
    ],
    "plugins": [
      "@babel/plugin-proposal-nullish-coalescing-operator"
    ]
  },
  "dependencies": {
    "@babel/core": "^7.24.7",
    "@sendgrid/mail": "^8.1.3",
    "babel-loader": "^9.1.3",
    "body-parser": "^1.20.2",
    "bree": "^9.2.3",
    "cloudinary": "^2.2.0",
    "compression": "^1.7.4",
    "cookie-parser": "~1.4.6",
    "cors": "^2.8.5",
    "debug": "~4.3.5",
    "dotenv": "^16.4.5",
    "ejs": "~3.1.10",
    "express": "~4.19.2",
    "ftp": "^0.3.10",
    "http-errors": "^2.0.0",
    "lodash": "^4.17.21",
    "maxmind": "^4.3.20",
    "mongoose": "^8.4.4",
    "morgan": "~1.10.0",
    "node-sass": "^9.0.0",
    "node-sass-middleware": "^1.1.0",
    "request": "^2.88.2",
    "ua-parser-js": "^1.0.38",
    "xml2js": "^0.6.2"
  },
  "engines": {
    "node": "20.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.15.5",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.17.12",
    "@babel/preset-env": "^7.15.6",
    "babel-loader": "^8.2.2",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.91.0",
    "webpack-cli": "^4.10.0"
  }
}
